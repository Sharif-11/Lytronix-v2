{
  "name": "lytronix-server",
  "version": "1.0.0",
  "description": "Lytronix unified API (Node, Express, Mongoose, MongoDB) - serves both the storefront and admin apps",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "migrate:categories": "node scripts/migrateCategories.js",
    "reset:db": "node scripts/resetDb.js",
    "seed:demo-product": "node scripts/seedDemoProduct.js",
    "restore:customers": "node scripts/restoreCustomers.js",
    "cleanup:cloudinary": "node scripts/cleanupCloudinary.js",
    "purge:chat": "node scripts/purgeChat.js"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nanoid": "^3.3.7",
    "sharp": "^0.33.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
