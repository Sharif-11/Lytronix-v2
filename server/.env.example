# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/lytronix

# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Storefront customer sessions = short access token + long refresh token, so
# a signed-in shopper stays logged in across reloads without another OTP.
JWT_CUSTOMER_ACCESS_EXPIRES_IN=1h
JWT_CUSTOMER_REFRESH_EXPIRES_IN=90d
# (legacy — no longer read; kept so old .env files don't error)
JWT_CUSTOMER_EXPIRES_IN=30d
# forgot-password: max SMS'd password resets per number per 24h
PW_RESET_MAX_PER_DAY=3

# ---- Storefront customer OTP login ----
OTP_LENGTH=6
OTP_TTL_MINUTES=5
# SMS costs money, so login codes per phone number are tightly capped:
#   OTP_MAX_PER_DAY   — codes allowed in any rolling 24h window; hitting it
#                       starts a full 24h cool-down for that number.
#   OTP_MAX_LIFETIME  — total codes ever for a number. Once reached, only an
#                       admin reset (Customers > edit > "Reset OTP limit",
#                       POST /api/customers/otp-reset) frees it.
OTP_MAX_PER_DAY=2
OTP_MAX_LIFETIME=5
# When SMS_API_KEY is unset AND NODE_ENV!=production, request-otp returns the
# code in the response body (devCode) so the flow is testable without a gateway.

# ---- Analytics ----
# Raw storefront events (product views, site visits) are pruned after this many
# days; the running totals on each product are kept.
ANALYTICS_EVENT_TTL_DAYS=180
# Repeat page views (site_visit / product_view / category_view) from the same
# visitor — matched by sessionId, logged-in customer, or hashed IP — inside
# this many minutes are ignored (0 disables de-dup).
ANALYTICS_DEDUPE_MINUTES=30
# Salt for hashing client IPs before storing them for de-dup. Defaults to
# JWT_SECRET if unset. Raw IPs are never persisted.
ANALYTICS_IP_SALT=

# ---- Proxy ----
# The API sits behind nginx / Cloudflare in production so req.ip is the real
# client. Set to the number of proxy hops in front of Node (1 for just nginx),
# or "true" to trust all, or a comma-list of trusted proxy IPs. Defaults to 1
# when NODE_ENV=production, off otherwise.
TRUST_PROXY=

# ---- Seed (used once by `npm run seed`) ----
# Required — every admin account (including this one) needs a phone number:
# it's the login identifier that always works and where "forgot password"
# SMS gets sent.
SEED_ADMIN_PHONE=01700000000
# Optional — email can additionally be used to log in, but isn't required.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin

# ---- Logging ----
# error | warn | info | http | debug — default 'http' (includes HTTP access
# logs). Written to server/logs/{combined,error}.log and the console.
LOG_LEVEL=

# ---- Web Push (admin PWA background notifications) ----
# Generate once:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is also served to the admin app at GET /api/push/config.
# Leave all three blank to disable push entirely (no-op, never throws).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Steadfast Courier API (https://portal.packzy.com) ----
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_TRACKING_URL_TEMPLATE=
# Bearer token you set in Steadfast's "Webhook Integration" screen; the same
# value is checked on POST /api/webhooks/steadfast.
STEADFAST_WEBHOOK_TOKEN=
# Printed on the courier label (Steadfast's "Merchant ID", e.g. TW0UBIVG).
STEADFAST_MERCHANT_ID=

# ---- AI-assisted order creation (Gemini and/or Anthropic) ----
# Admin's New Order page: paste customer text (or a screenshot, Anthropic
# only for now) -> prefilled form, with the district/thana matched onto the
# Steadfast hub list. Without a key the panel just says "not configured" and
# the form works normally.
#
# Gemini (Google AI Studio) has a genuinely free tier — get a key at
# https://aistudio.google.com/apikey, no billing account needed. TEXT ONLY
# for now (image support is coming). Preferred automatically when set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash   # check https://ai.google.dev/gemini-api/docs/models for the current free-tier list
#
# Anthropic (Claude) — paid, but supports text + image. Used when
# GEMINI_API_KEY is unset, or force either provider with AI_PROVIDER=gemini|anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_PROVIDER=
# Identical pasted text (a retry, a double-click) is served from an in-memory
# cache instead of hitting the provider again, for this many minutes.
# AI_CACHE_TTL_MINUTES=15

# ---- SMS (BulkSMSBD, http://bulksmsbd.net) ----
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=http://bulksmsbd.net/api/smsapi
# Outside production (NODE_ENV != production) SMS is MOCKED: every send is
# logged and reported as delivered, but the paid gateway is never hit, and
# the balance check returns a fake healthy credit. Set SMS_LIVE=true to send
# for real even in dev (e.g. a one-off delivery test).
# SMS_LIVE=true
# Comma-separated phone numbers to notify whenever a new order comes in
# (the "multiple listeners" — add as many as you need, e.g. 01700000000,01800000000)
ADMIN_NOTIFY_PHONES=

# ---- Cloudinary (image uploads: product photos, bKash payment proofs) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- bKash Manual transfer (shown to customers at checkout) ----
BKASH_MERCHANT_NUMBER=01776775495

# ---- bKash Automated (tokenized) Checkout ----
# Offered on the storefront ONLY when configured AND BKASH_AUTO_ENABLED=true.
# Keep BKASH_AUTO_ENABLED unset/false in production until live merchant
# credentials + an https callback are ready. Sandbox: developer.bka.sh
BKASH_AUTO_ENABLED=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
# Public base URL of this API — used to build the bKash browser callback URL.
# Defaults to the incoming request's host if unset.
API_BASE_URL=
# DEV / TEST ONLY: pre-fills the wallet number on the bKash sandbox page.
# Set to a sandbox success wallet for one-tap testing; leave UNSET in
# production so the shopper's own phone is used as the payer reference.
BKASH_PAYER_REFERENCE=
