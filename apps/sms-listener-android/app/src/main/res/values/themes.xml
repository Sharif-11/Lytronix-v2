<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only: the brand colours and card surfaces are designed for it. -->
    <style name="Theme.LytronixSms" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand</item>
    </style>

    <style name="SoftButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="DangerText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/danger</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
