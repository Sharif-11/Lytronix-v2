<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lytronix SMS Listener"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Forwards your bKash payment SMS to the Lytronix server." />

        <!-- ================= Not paired yet ================= -->
        <LinearLayout
            android:id="@+id/setupGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Server address, e.g. https://api.example.com/api"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/pairCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pairing code (8 characters)"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="12" />

            <EditText
                android:id="@+id/deviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name for this phone"
                android:inputType="text" />

            <Button
                android:id="@+id/pairButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pair with server" />

            <TextView
                android:id="@+id/pairMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ================= Paired ================= -->
        <LinearLayout
            android:id="@+id/pairedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/syncNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Send stored messages now" />

            <Button
                android:id="@+id/permButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow reading incoming SMS" />

            <Button
                android:id="@+id/batteryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keep running in the background" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Forward SMS from these senders (comma separated)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/senders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

            <Button
                android:id="@+id/saveSenders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save senders" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Recent messages"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textSize="12sp" />

            <Button
                android:id="@+id/unpair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Unpair this phone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
