# Leave unset in dev — Vite proxies /api to the local server (see vite.config.js).
# Set this to the deployed API's base URL for production builds.
VITE_API_URL=

# The public storefront URL — used to build shareable product order links
# shown in the admin. Defaults to the local storefront dev server if unset.
VITE_STOREFRONT_URL=
