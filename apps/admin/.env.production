# Loaded automatically by `vite build`. Values are baked into the bundle, so
# set the REAL URLs before building.
VITE_API_URL=https://lytronix-v2.onrender.com/api
# Public storefront URL — used for the "copy public order link" button.
# Set this to the storefront's deployed URL before building the admin.
VITE_STOREFRONT_URL=https://REPLACE-storefront-domain
