# Leave unset in dev — Vite proxies /api to the local server (see vite.config.js).
# Set this to the deployed API's base URL for production builds.
VITE_API_URL=

# Absolute base for shareable links the storefront generates (e.g. the order
# tracking URL shown after checkout on a product landing page). Falls back to
# window.location.origin when unset. In production set it to the storefront's
# public URL; in LAN dev set it to the machine's IP, e.g. http://192.168.0.101:5173
VITE_PUBLIC_URL=
